# Application
APP_NAME=CySIEM Layer 3 - Asset Intelligence
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
# Port 5433 (not Postgres's default 5432) because this points at the
# isolated, CySIEM-only Postgres instance scripts/setup_isolated_postgres.ps1
# creates - a separate data directory/port so it never touches or conflicts
# with any Postgres already installed on your machine. Run that script once,
# then this default just works. (If you're running everything via
# `docker compose up` instead, ignore this file - docker-compose.yml sets
# DATABASE_URL itself, pointing at its own postgres container on the
# internal Docker network.)
DATABASE_URL=postgresql+asyncpg://cysiem:cysiem_test_pw@localhost:5433/cysiem_layer3

# Security
SECRET_KEY=change-me-in-production
API_KEY=change-me-dev-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Threat Intel Integrations (optional - leave blank to run in stub mode)
MISP_URL=
MISP_API_KEY=
OTX_API_KEY=

# Kafka (optional - leave blank to disable event publishing)
KAFKA_BOOTSTRAP_SERVERS=

# Worker
THREAT_INTEL_SYNC_INTERVAL_MINUTES=60
