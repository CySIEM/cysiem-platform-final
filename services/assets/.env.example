# Application
APP_NAME=CySIEM Layer 3 - Asset Intelligence
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://cysiem:cysiem@localhost:5432/cysiem_layer3

# Security
SECRET_KEY=change-me-in-production
API_KEY=change-me-dev-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Threat Intel Integrations (optional - leave blank to run in stub mode)
MISP_URL=
MISP_API_KEY=
OTX_API_KEY=

# Kafka (optional - leave blank to disable event publishing)
KAFKA_BOOTSTRAP_SERVERS=

# Worker
THREAT_INTEL_SYNC_INTERVAL_MINUTES=60
